rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public Read: Allows potential clients/visitors to view projects and data.
    match /{document=**} {
      allow read: if true;
      
      // Protected Write: Restricts create, update, and delete operations to authenticated admins only.
      allow write: if request.auth != null; 
    }
  }
}