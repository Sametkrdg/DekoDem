rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Public CDN assets (project images, activity photos, gallery) ──────────
    // Only files explicitly under /public/ are world-readable.
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size   <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Deny everything else — no catch-all public read ───────────────────────
    match /{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size <= 10 * 1024 * 1024;
    }
  }
}
