# ─────────────────────────────────────────────────────────────────────────────
# .env.example — DEKODEM
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# EmailJS — https://www.emailjs.com/docs/
REACT_APP_EMAILJS_SERVICE_ID=service_xxxxxxx
REACT_APP_EMAILJS_TEMPLATE_ID=template_xxxxxxx
REACT_APP_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx

# Firebase — https://console.firebase.google.com/ → Project Settings → Your apps
REACT_APP_FIREBASE_API_KEY=AIzaSy...
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=000000000000
REACT_APP_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
REACT_APP_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Google reCAPTCHA v3 — https://www.google.com/recaptcha/admin
REACT_APP_RECAPTCHA_SITE_KEY=6Lxx...

# Cloudinary — https://cloudinary.com/console
# UPLOAD_PRESET must be an *unsigned* preset (Dashboard → Settings → Upload → Upload presets)
REACT_APP_CLOUDINARY_CLOUD_NAME=your-cloud-name
REACT_APP_CLOUDINARY_API_KEY=000000000000000
REACT_APP_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
